SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# alamat backend (lokal atau Heroku) dan kunci bersama, sama dengan YOLO_SERVICE_KEY di backend
BACKEND_URL=http://localhost:3001
YOLO_SERVICE_KEY=ganti-dengan-string-acak-panjang

# Bobot YOLO badminton lokal; docker-compose me-mount folder Track_Model/yolo11 ke /srv/models/badminton-yolo11.
BADMINTON_YOLO_DIR=./vendor/Yolo-and-TrackNet-Badminton-Analysis-main/Track_Model/yolo11

SEGMENT_BUCKET=segments
MODELS_BUCKET=models
MODELS_DIR=./models
TMP_DIR=./tmp

# cuda | cpu | auto
DEVICE=auto
# Aktifkan hanya untuk demo lokal/jaringan development tepercaya.
LIVE_DEMO_ENABLED=true
POLL_INTERVAL_SECONDS=2
MAX_ATTEMPTS=3

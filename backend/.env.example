NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# kunci bersama dengan yolo-service (minimal 16 karakter)
YOLO_SERVICE_KEY=ganti-dengan-string-acak-panjang

# gateway pembayaran: "fake" untuk dev/test, "lxpay" untuk QRIS LeonXLab produksi
# (keputusan: docs/decisions/payment-gateway.md, docs: https://leonxlab.app/docs/lxpay)
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=ganti-dengan-string-acak-panjang

# kredensial LxPay (dipakai bila PAYMENT_PROVIDER=lxpay). API key xpk_live_…
# ditampilkan sekali saat pendaftaran merchant di dashboard LxPay.
LXPAY_API_KEY=
# secret webhook dari pengaturan merchant (header X-Lxpay-Signature)
LXPAY_WEBHOOK_SECRET=
# biarkan default kecuali base URL gateway berubah
LXPAY_BASE_URL=https://leonxlab.app

# OTP email via SMTP Resend (daftar & login). Kosongkan RESEND_API_KEY di dev untuk mode log.
RESEND_API_KEY=
# host/port SMTP Resend (default benar; cukup diubah kalau Resend menggantinya)
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
# pengirim email OTP — ganti domain setelah terverifikasi di Resend
RESEND_FROM_EMAIL=Peluit OTP <otp@id.leonxlab.com>
# pepper untuk hash email/kode/IP OTP. Wajib diisi acak (>=32 karakter) di produksi.
OTP_PEPPER=

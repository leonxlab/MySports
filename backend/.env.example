NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# kunci bersama dengan yolo-service (minimal 16 karakter)
YOLO_SERVICE_KEY=ganti-dengan-string-acak-panjang

# gateway belum dipilih (lihat proposal, bagian Pembayaran)
PAYMENT_PROVIDER=undecided
PAYMENT_WEBHOOK_SECRET=

# OTP email via SMTP Resend (daftar & login). Kosongkan RESEND_API_KEY di dev untuk mode log.
RESEND_API_KEY=
# host/port SMTP Resend (default benar; cukup diubah kalau Resend menggantinya)
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
# pengirim email OTP — ganti domain setelah terverifikasi di Resend
RESEND_FROM_EMAIL=Peluit OTP <otp@id.leonxlab.com>
# pepper untuk hash email/kode/IP OTP. Wajib diisi acak (>=32 karakter) di produksi.
OTP_PEPPER=

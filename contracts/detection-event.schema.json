{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detection-event.schema.json",
  "title": "Kontrak event YOLO -> backend",
  "description": "Dikirim yolo-service ke POST /api/v1/devices/events dengan header x-service-key. AI hanya mengusulkan kejadian, poin dihitung backend. Perubahan file ini = PR terpisah yang disetujui berdua (rules.md bagian 5).",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "required": [
    "events"
  ],
  "$defs": {
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid",
              "description": "Kunci idempotensi, dibuat yolo-service"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "match_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "segment_id": {
              "type": "string",
              "format": "uuid"
            },
            "camera": {
              "enum": [
                "home",
                "away"
              ]
            },
            "sport": {
              "enum": [
                "basketball",
                "badminton",
                "tennis",
                "padel",
                "futsal"
              ]
            },
            "timestamp_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Waktu kejadian di dalam match"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "type": {
              "const": "basket_made"
            },
            "payload": {
              "type": "object",
              "properties": {
                "team_color": {
                  "type": "string"
                },
                "shot_distance_m": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "event_id",
            "session_id",
            "match_id",
            "segment_id",
            "camera",
            "sport",
            "timestamp_ms",
            "confidence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid",
              "description": "Kunci idempotensi, dibuat yolo-service"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "match_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "segment_id": {
              "type": "string",
              "format": "uuid"
            },
            "camera": {
              "enum": [
                "home",
                "away"
              ]
            },
            "sport": {
              "enum": [
                "basketball",
                "badminton",
                "tennis",
                "padel",
                "futsal"
              ]
            },
            "timestamp_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Waktu kejadian di dalam match"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "type": {
              "const": "goal"
            },
            "payload": {
              "type": "object",
              "properties": {
                "team_color": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "event_id",
            "session_id",
            "match_id",
            "segment_id",
            "camera",
            "sport",
            "timestamp_ms",
            "confidence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid",
              "description": "Kunci idempotensi, dibuat yolo-service"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "match_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "segment_id": {
              "type": "string",
              "format": "uuid"
            },
            "camera": {
              "enum": [
                "home",
                "away"
              ]
            },
            "sport": {
              "enum": [
                "basketball",
                "badminton",
                "tennis",
                "padel",
                "futsal"
              ]
            },
            "timestamp_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Waktu kejadian di dalam match"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "type": {
              "const": "ball_landed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "in_bounds": {
                  "type": "boolean"
                },
                "side": {
                  "enum": [
                    "home",
                    "away"
                  ]
                }
              },
              "required": [
                "in_bounds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event_id",
            "session_id",
            "match_id",
            "segment_id",
            "camera",
            "sport",
            "timestamp_ms",
            "confidence",
            "type",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid",
              "description": "Kunci idempotensi, dibuat yolo-service"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "match_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "segment_id": {
              "type": "string",
              "format": "uuid"
            },
            "camera": {
              "enum": [
                "home",
                "away"
              ]
            },
            "sport": {
              "enum": [
                "basketball",
                "badminton",
                "tennis",
                "padel",
                "futsal"
              ]
            },
            "timestamp_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Waktu kejadian di dalam match"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "type": {
              "const": "play_activity"
            },
            "payload": {
              "type": "object",
              "properties": {
                "active_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "players_detected": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "active_seconds",
                "players_detected"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event_id",
            "session_id",
            "match_id",
            "segment_id",
            "camera",
            "sport",
            "timestamp_ms",
            "confidence",
            "type",
            "payload"
          ]
        }
      ]
    }
  }
}
